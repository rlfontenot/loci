//-----------------------------------------------------------------------------
// Rules for general-cell face plans
//-----------------------------------------------------------------------------

$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1, face2node,
(cl, cr)->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(cl, cr)->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(interior_faces, (cl, cr)->gnrlcells) {
  $balancedFacePlan1.clear() ;

  std::vector<char> facePlanL = extract_general_face($cl->$lower.begin(),
                                                     $cl->$lower.size(),
                                                     $cl->$upper.begin(),
                                                     $cl->$upper.size(),
                                                     $cl->$boundary_map.begin(),
                                                     $cl->$boundary_map.size(),
                                                     $*face2node,
                                                     $*face2edge,
                                                     $*edge2node,
                                                     $cl->$balancedCellPlan1,
                                                     _e_,
                                                     $*fileNumber(pos)) ;

  std::vector<char> facePlanR = extract_general_face($cr->$lower.begin(),
                                                     $cr->$lower.size(),
                                                     $cr->$upper.begin(),
                                                     $cr->$upper.size(),
                                                     $cr->$boundary_map.begin(),
                                                     $cr->$boundary_map.size(),
                                                     $*face2node,
                                                     $*face2edge,
                                                     $*edge2node,
                                                     $cr->$balancedCellPlan1,
                                                     _e_,
                                                     $*fileNumber(pos)) ;

  $balancedFacePlan1 = merge_faceplan(facePlanL, facePlanR, $face2node.size()) ;
  reduce_vector($balancedFacePlan1) ;
}

$rule pointwise(balancedFacePlan1 <- cl->balancedCellPlan1,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(boundary_faces, cl->gnrlcells) {
  $balancedFacePlan1 = extract_general_face($cl->$lower.begin(),
                                           $cl->$lower.size(),
                                           $cl->$upper.begin(),
                                           $cl->$upper.size(),
                                           $cl->$boundary_map.begin(),
                                           $cl->$boundary_map.size(),
                                           $*face2node,
                                           $*face2edge,
                                           $*edge2node,
                                           $cl->$balancedCellPlan1,
                                           _e_,
                                           $*fileNumber(pos)) ;
  reduce_vector($balancedFacePlan1) ;
}


//-----------------------------------------------------------------------------
// Rules for hex-cell face plans
//-----------------------------------------------------------------------------

/// This rule first extracts faceplan from cl and cr, then merge them into one final plan
/// in the face's local coordinates system
///
/// To merge the plans,  use a queue of ranges to simulate the tree splitting
/// process, and put the inner eges in list xEdge and yEdges according to their directions.
///
/// Then sort and unique xEdge and yEdge. and then merge all the overlapped edges
///
/// The last step is compose a new refinement plan according to xEdges and yEdges. Search
/// the inner edges of a parent cell, the result implies the split code. repeat the same process for
/// each child.

/// Merge derefinement face plans from the hexahedral cells adjacent to
/// an interior face.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
(cl, cr)->hexOrientCode, fl, fr),
constraint(interior_faces, (cl, cr)->hexcells) {
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan1,
                                                 DIRECTION($fl)) ;
  std::vector<char> facePlanR = extract_hex_face($cr->$balancedCellPlan1,
                                                 DIRECTION($fr)) ;
  $balancedFacePlan1 = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl],
                                        facePlanR, $cr->$hexOrientCode[$fr]) ;
  reduce_vector($balancedFacePlan1) ;
}

/// Extract the derefinement face plan from the hexahedral cell adjacent to a
/// boundary face.
$rule pointwise(balancedFacePlan1 <- cl->balancedCellPlan1,
cl->hexOrientCode, fl),
constraint(boundary_faces, cl->hexcells) {
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan1,
                                                 DIRECTION($fl)) ;
  $balancedFacePlan1 = merge_quad_face(facePlanL,
                                        $cl->$hexOrientCode[$fl]) ;
  reduce_vector($balancedFacePlan1) ;
}


//-----------------------------------------------------------------------------
// Rules for prism-cell face plans
//-----------------------------------------------------------------------------

/// This rule first extracts faceplan from cl and cr, then merges them into one final plan
/// in the face's local coordinates system.
///
/// To merge the plans, use a queue of ranges to simulate the tree splitting
/// process, and put the inner eges in list xEdge and yEdges according to their directions.
/// Then sort and unique xEdge and yEdge. and then merge all the overlapped edges
///
/// The last step is compose a new refinement plan according to xEdges and yEdges. Search
/// the inner edges of a parent cell, the result implies the split code. repeat the same process for
/// each child.

/// Merge derefinement face plans from the prism cells adjacent to an
/// interior face.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
(cl, cr)->prismOrientCode, fl, fr),
constraint((cl, cr)->prisms) {
  if($fl < 2) {
    $balancedFacePlan1 = merge_prism_tri_face_plans(
      $cl->$balancedCellPlan1, $fl, $cl->$prismOrientCode[$fl],
      $cr->$balancedCellPlan1, $fr, $cr->$prismOrientCode[$fr]) ;
  }else {
    $balancedFacePlan1 = merge_prism_quad_face_plans(
      $cl->$balancedCellPlan1, $fl, $cl->$prismOrientCode[$fl],
      $cr->$balancedCellPlan1, $fr, $cr->$prismOrientCode[$fr]) ;
  }
  reduce_vector($balancedFacePlan1) ;
}

/// Extract the derefinement face plan from the prism cell adjacent to a
/// boundary face.
$rule pointwise(balancedFacePlan1 <- cl->balancedCellPlan1,
cl->prismOrientCode, fl),
constraint(boundary_faces, cl->prisms) {
  if($fl < 2) {
    $balancedFacePlan1 = extract_oriented_prism_tri_face_plan(
      $cl->$balancedCellPlan1, $fl, $cl->$prismOrientCode[$fl]) ;
  }else {
    $balancedFacePlan1 = extract_oriented_prism_quad_face_plan(
      $cl->$balancedCellPlan1, $fl, $cl->$prismOrientCode[$fl]) ;
  }
  reduce_vector($balancedFacePlan1) ;
}


//-----------------------------------------------------------------------------
// Rules for mixed-topology face plans
//-----------------------------------------------------------------------------

/// Merge derefinement face plans between a general cell on the left and a
/// hexahedral cell on the right.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
cr->hexOrientCode, fr,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cl->gnrlcells, cr->hexcells) {
  $balancedFacePlan1.clear() ;

  std::vector<char> localPlanL = extract_general_face($cl->$lower.begin(),
                                                      $cl->$lower.size(),
                                                      $cl->$upper.begin(),
                                                      $cl->$upper.size(),
                                                      $cl->$boundary_map.begin(),
                                                      $cl->$boundary_map.size(),
                                                      $*face2node,
                                                      $*face2edge,
                                                      $*edge2node,
                                                      $cl->$balancedCellPlan1,
                                                      _e_,
                                                      $*fileNumber(pos)) ;

  std::vector<char> facePlanL = transfer_plan_g2q(localPlanL) ;
  std::vector<char> facePlanR = extract_hex_face($cr->$balancedCellPlan1,
                                                 DIRECTION($fr)) ;

  $balancedFacePlan1 = merge_quad_face(facePlanL, char(0),
                                       facePlanR, $cr->$hexOrientCode[$fr]) ;
  reduce_vector($balancedFacePlan1) ;
}

/// Merge derefinement face plans between a hexahedral cell on the left and a
/// general cell on the right.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
cl->hexOrientCode, fl,
cr->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cr->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cr->gnrlcells, cl->hexcells) {
  $balancedFacePlan1.clear() ;

  std::vector<char> localPlanR = extract_general_face($cr->$lower.begin(),
                                                      $cr->$lower.size(),
                                                      $cr->$upper.begin(),
                                                      $cr->$upper.size(),
                                                      $cr->$boundary_map.begin(),
                                                      $cr->$boundary_map.size(),
                                                      $*face2node,
                                                      $*face2edge,
                                                      $*edge2node,
                                                      $cr->$balancedCellPlan1,
                                                      _e_,
                                                      $*fileNumber(pos)) ;
  std::vector<char> facePlanR = transfer_plan_g2q(localPlanR) ;
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan1,
                                                 DIRECTION($fl)) ;

  $balancedFacePlan1 = merge_quad_face(facePlanR, char(0),
                                       facePlanL, $cl->$hexOrientCode[$fl]) ;
  reduce_vector($balancedFacePlan1) ;
}

/// Merge derefinement face plans between a general cell on the left and a
/// prism cell on the right.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
face2node, cr->prismOrientCode, fr,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cl->gnrlcells, cr->prisms) {
  $balancedFacePlan1.clear() ;

  std::vector<char> localPlanL = extract_general_face($cl->$lower.begin(),
                                                      $cl->$lower.size(),
                                                      $cl->$upper.begin(),
                                                      $cl->$upper.size(),
                                                      $cl->$boundary_map.begin(),
                                                      $cl->$boundary_map.size(),
                                                      $*face2node,
                                                      $*face2edge,
                                                      $*edge2node,
                                                      $cl->$balancedCellPlan1,
                                                      _e_,
                                                      $*fileNumber(pos)) ;

  if($fr < 2) {
    std::vector<char> facePlanR =
      extract_oriented_prism_tri_face_plan(
        $cr->$balancedCellPlan1, $fr, $cr->$prismOrientCode[$fr]) ;
    $balancedFacePlan1 = merge_faceplan(localPlanL, facePlanR,
                                        $face2node.size()) ;
  }else {
    std::vector<char> facePlanR = extract_prism_face($cr->$balancedCellPlan1,
                                                     $fr) ;
    std::vector<char> facePlanL = transfer_plan_g2q(localPlanL) ;
    $balancedFacePlan1 = merge_quad_face(facePlanL, char(0),
                                         facePlanR,
                                         $cr->$prismOrientCode[$fr]) ;
  }
  reduce_vector($balancedFacePlan1) ;
}

/// Merge derefinement face plans between a prism cell on the left and a
/// general cell on the right.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
face2node, cl->prismOrientCode, fl,
cr->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cr->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cr->gnrlcells, cl->prisms) {
  $balancedFacePlan1.clear() ;

  std::vector<char> localPlanR = extract_general_face($cr->$lower.begin(),
                                                      $cr->$lower.size(),
                                                      $cr->$upper.begin(),
                                                      $cr->$upper.size(),
                                                      $cr->$boundary_map.begin(),
                                                      $cr->$boundary_map.size(),
                                                      $*face2node,
                                                      $*face2edge,
                                                      $*edge2node,
                                                      $cr->$balancedCellPlan1,
                                                      _e_,
                                                      $*fileNumber(pos)) ;

  if($fl < 2) {
    std::vector<char> facePlanL =
      extract_oriented_prism_tri_face_plan(
        $cl->$balancedCellPlan1, $fl, $cl->$prismOrientCode[$fl]) ;
    $balancedFacePlan1 = merge_faceplan(facePlanL, localPlanR,
                                        $face2node.size()) ;
  }else {
    std::vector<char> facePlanL = extract_prism_face($cl->$balancedCellPlan1,
                                                     $fl) ;
    std::vector<char> facePlanR = transfer_plan_g2q(localPlanR) ;

    $balancedFacePlan1 = merge_quad_face(facePlanR, char(0),
                                         facePlanL,
                                         $cl->$prismOrientCode[$fl]) ;
  }
  reduce_vector($balancedFacePlan1) ;
}

/// Merge derefinement face plans between a hexahedral cell on the left and a
/// prism cell on the right.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
cr->prismOrientCode, cl->hexOrientCode, fl, fr),
constraint(cl->hexcells, cr->prisms) {
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan1,
                                                 DIRECTION($fl)) ;
  std::vector<char> facePlanR = extract_prism_face($cr->$balancedCellPlan1,
                                                   $fr) ;
  $balancedFacePlan1 = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl],
                                       facePlanR, $cr->$prismOrientCode[$fr]) ;
  reduce_vector($balancedFacePlan1) ;
}

/// Merge derefinement face plans between a prism cell on the left and a
/// hexahedral cell on the right.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
cl->prismOrientCode, cr->hexOrientCode, fl, fr),
constraint(cr->hexcells, cl->prisms) {
  std::vector<char> facePlanR = extract_hex_face($cr->$balancedCellPlan1,
                                                 DIRECTION($fr)) ;
  std::vector<char> facePlanL = extract_prism_face($cl->$balancedCellPlan1,
                                                   $fl) ;
  $balancedFacePlan1 = merge_quad_face(facePlanL, $cl->$prismOrientCode[$fl],
                                       facePlanR, $cr->$hexOrientCode[$fr]) ;
  reduce_vector($balancedFacePlan1) ;
}


//-----------------------------------------------------------------------------
// Rules for edge plans
//-----------------------------------------------------------------------------

/// Intermediate set of integer edge split coordinates implied by balancedFacePlan1.
/// Multiple faces can contribute to the same edge; apply rules merge these sets.
$type balancedPointSet1 store<SetLong> ;

$rule unit(balancedPointSet1), constraint(edge2node->pos){
  $balancedPointSet1 = SetLong() ;
}

/// Project the balanced face plan onto its boundary edges for union merging.
$rule apply(face2edge->balancedPointSet1<-balancedFacePlan1, is_quadface,
face2node->pos, face2edge->edge2node->pos, face2edge->balancedPointSet1)[SetLongUnionOp],
constraint(faces) {
  if($is_quadface && $face2node.size() != 4) {
    cerr << "WARNING: quadrilateral face must have four nodes" << endl ;
    Loci::Abort() ;
  }

  if($balancedFacePlan1.size() == 0) { return ; }

  const int edgeCount = $is_quadface ? $face2edge.size() : $face2node.size() ;
  std::vector<bool> edgeReversed(edgeCount, false) ;

  if($is_quadface) {
    for(int i=0; i<edgeCount; i++) {
      if(i == 0 && $face2edge[0]->$edge2node[0] == $face2node[1]) {
        edgeReversed[i] = true ;
      }else if(i == 1 && $face2edge[1]->$edge2node[0] == $face2node[2]) {
        edgeReversed[i] = true ;
      }else if(i == 2 && $face2edge[2]->$edge2node[0] == $face2node[2]) {
        edgeReversed[i] = true ;
      }else if(i == 3 && $face2edge[3]->$edge2node[0] == $face2node[3]) {
        edgeReversed[i] = true ;
      }
    }
  }else {
    for(int i=0; i<edgeCount; i++) {
      edgeReversed[i] =
        !($face2edge[i]->$edge2node[0] == $face2node[i] &&
          $face2edge[i]->$edge2node[1] ==
            $face2node[i==(edgeCount-1)?0:i+1]) ;
    }
  }

  const std::vector<SetLong> edgeSplits =
    project_face_plan_to_edge_splits(
      $balancedFacePlan1, $is_quadface, edgeReversed) ;
  for(int i=0; i<edgeCount; i++) {
    if(edgeSplits[i].aset.empty()) { continue ; }
    join($face2edge[i]->$balancedPointSet1, edgeSplits[i]) ;
  }
}

$rule pointwise(balancedEdgePlan1<-balancedPointSet1) {
  if($balancedPointSet1.aset.empty()) { return ; }
  encode_edge_plan($balancedPointSet1, $balancedEdgePlan1) ;
}


//-----------------------------------------------------------------------------
// Rules for the no-derefinement pass-through
//-----------------------------------------------------------------------------

$rule pointwise(balancedCellPlan <- balancedCellPlan1, beginWithMarker),
option(disable_threading) {
  // dummy parameter to trick Loci scheduler
  $balancedCellPlan = $balancedCellPlan1 ;
}

//-----------------------------------------------------------------------------
// Rules for general-cell derefinement from node tags
//-----------------------------------------------------------------------------

/// Dummy parameter to trick Loci scheduler
$rule pointwise(priority::restart::balancedCellPlan <- beginWithMarker,
restart_tag_par, cellPlan, balancedCellPlan1, nodeTag, isIndivisible,
(lower, upper, boundary_map)->(facePlan, balancedFacePlan1, is_quadface, nodeTag),
(lower, upper, boundary_map)->face2node->(pos, posTag, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2edge->(edgePlan, balancedEdgePlan1, nodeTag)),
constraint(gnrlcells) {

  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<Face*> face_list ;
    std::list<Node*> bnode_list ;

    Cell* aCell = build_resplit_general_cell($lower.begin(), $lower.size(),
                                             $upper.begin(), $upper.size(),
                                             $boundary_map.begin(), $boundary_map.size(),
                                             $*is_quadface,
                                             $*face2node,
                                             $*face2edge,
                                             $*edge2node,
                                             $*pos,
                                             $*edgePlan,
                                             $*facePlan,
                                             $*balancedEdgePlan1,
                                             $*balancedFacePlan1,
                                             $*posTag,
                                             $*nodeTag,
                                             bnode_list,
                                             node_list,
                                             edge_list,
                                             face_list,
                                             $*fileNumber(pos),
                                             $cellPlan,
                                             $nodeTag) ;

    std::vector<DiamondCell*> cells ; // leaves collected according to cellPlan1
    aCell->resplit($balancedCellPlan1, node_list, edge_list, face_list, cells) ;

    // re-collect leaves according to tree structure
    std::list<DiamondCell*> leaves ;
    aCell->sort_leaves(leaves) ;

    // first if any cell need derefine
    std::set<DiamondCell*> dparents ;
    bool check_root = false ;

    // mark the cell that will be eliminated
    for(std::list<DiamondCell*>::const_iterator li = leaves.begin(); li != leaves.end(); li++) {
      if((*li)->get_tagged() ==2) {
        DiamondCell* parent = (*li)->getParentCell() ;
        if(parent==0) { check_root = true ; }
        if(parent!=0 && parent->needDerefine()) {
          dparents.insert(parent) ;
        }
      }
    }

    // derefine the cells
    for(std::set<DiamondCell*>::const_iterator si = dparents.begin(); si!= dparents.end(); si++) {
      (*si)->derefine() ;
    }
    if(check_root) {
      if(aCell->needDerefine()) aCell->derefine() ;
    }

    $balancedCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($balancedCellPlan) ;
  }
}


//-----------------------------------------------------------------------------
// Rules for general-cell derefinement from cell tags
//-----------------------------------------------------------------------------

/// Dummy parameter to trick Loci scheduler
$rule pointwise(priority::restart::balancedCellPlan <- beginWithMarker,
restart_tag_par, cellPlan, balancedCellPlan1, fineCellTag, isIndivisible,
(lower, upper, boundary_map)->(facePlan, balancedFacePlan1, is_quadface),
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2edge->(edgePlan, balancedEdgePlan1)),
constraint(gnrlcells) {

  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<Face*> face_list ;
    std::list<Node*> bnode_list ;

    Cell* aCell = build_resplit_general_cell_ctag($lower.begin(), $lower.size(),
                                                  $upper.begin(), $upper.size(),
                                                  $boundary_map.begin(), $boundary_map.size(),
                                                  $*is_quadface,
                                                  $*face2node,
                                                  $*face2edge,
                                                  $*edge2node,
                                                  $*pos,
                                                  $*edgePlan,
                                                  $*facePlan,
                                                  $*balancedEdgePlan1,
                                                  $*balancedFacePlan1,
                                                  bnode_list,
                                                  node_list,
                                                  edge_list,
                                                  face_list,
                                                  $*fileNumber(pos),
                                                  $cellPlan,
                                                  $fineCellTag) ;

    std::vector<DiamondCell*> cells ; // leaves collected according to cellPlan1
    aCell->resplit($balancedCellPlan1, node_list, edge_list, face_list, cells) ;

    // recollect leaves according to tree structure
    std::list<DiamondCell*> leaves ;
    aCell->sort_leaves(leaves) ;

    // first if any cell need derefine
    std::set<DiamondCell*> dparents ;
    bool check_root = false ;

    // mark the cell that will be eliminated
    for(std::list<DiamondCell*>::const_iterator li= leaves.begin(); li != leaves.end(); li++) {
      if((*li)->getTag() ==2) {
        DiamondCell* parent = (*li)->getParentCell() ;
        if(parent==0)check_root = true ;
        if(parent!=0 && parent->needDerefine_ctag()) {
          dparents.insert(parent) ;
        }
      }
    }

    // derefine the cells
    for(std::set<DiamondCell*>::const_iterator si = dparents.begin(); si!= dparents.end(); si++) {
      (*si)->derefine() ;
    }
    if(check_root) {
      if(aCell->needDerefine_ctag()) { aCell->derefine() ; }
    }

    $balancedCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($balancedCellPlan) ;
  }
}


//-----------------------------------------------------------------------------
// Rules for hex-cell derefinement from node tags
//-----------------------------------------------------------------------------

/// Make a newCellPlan according to cellPlan and nodeTag, posTag
$rule pointwise(priority::restart::balancedCellPlan <- beginWithMarker,
restart_tag_par, split_mode_par, cellPlan, balancedCellPlan1, nodeTag,
hex2face, hex2node, hexOrientCode, isIndivisible,
(lower, upper, boundary_map)->(facePlan, balancedFacePlan1, nodeTag),
(lower, upper, boundary_map)->face2node->(pos, posTag),
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2edge->(edgePlan, balancedEdgePlan1,
                                          nodeTag),
(lower, upper, boundary_map)->fileNumber(face2node)),
constraint(hexcells) {
  // dummy parameter to trick Loci scheduler
  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<QuadFace*> face_list ;
    std::list<Node*> bnode_list ;

    HexCell* aCell = build_resplit_hex_cell($lower.begin(), $lower.size(),
                                            $upper.begin(), $upper.size(),
                                            $boundary_map.begin(), $boundary_map.size(),
                                            $hex2face,
                                            $hex2node,
                                            $hexOrientCode,
                                            $*face2node,
                                            $*face2edge,
                                            $*edge2node,
                                            $*pos,
                                            $*edgePlan,
                                            $*facePlan,
                                            $*balancedEdgePlan1,
                                            $*balancedFacePlan1,
                                            $*posTag,
                                            $*nodeTag,
                                            bnode_list,
                                            node_list,
                                            edge_list,
                                            face_list,
                                            $*fileNumber(face2node),
                                            $cellPlan,
                                            $nodeTag) ;

    std::vector<HexCell*> cells ; // leaves collected according to cellPlan1
    aCell->resplit( $balancedCellPlan1, node_list, edge_list, face_list, cells) ;

    // re-collect leaves according to tree structure
    std::list<HexCell*> leaves ;
    aCell->sort_leaves(leaves) ;

    // first if any cell need derefine
    std::set<HexCell*> dparents ;

    for(std::list<HexCell*>::const_iterator li = leaves.begin(); li != leaves.end(); li++) {
      if((*li)->get_tagged() == 2) {
        HexCell* parent = (*li)->getParentCell() ;
        if(parent!=0 && parent->needDerefine()) {
          dparents.insert(parent) ;
        }
      }
    }

    // derefine the cells
    for(std::set<HexCell*>::const_iterator si = dparents.begin(); si!= dparents.end(); si++) {
      (*si)->derefine() ;
    }

    $balancedCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($balancedCellPlan) ;
  }
}


//-----------------------------------------------------------------------------
// Rules for hex-cell derefinement from cell tags
