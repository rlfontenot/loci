//int currentMem(void) ;

#ifdef USE_LIBXML2
bool mark_node(xmlNode* root_element,
               std::list<Node*>::iterator begin_pnt,
               std::list<Node*>::iterator end_pnt) ;
#endif

//-----------------------------------------------------------------------------
// Rules for node-tag refinement
//-----------------------------------------------------------------------------

/// Make a newCellPlan according to cellPlan and nodeTag, posTag
$rule pointwise(newCellPlan <- restart_tag_par, split_mode_par,
cellPlan, nodeTag, hex2face, hex2node, hexOrientCode, isIndivisible,
(lower, upper, boundary_map)->(facePlan, nodeTag),
(lower, upper, boundary_map)->face2node->(pos, posTag),
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2edge->(edgePlan, nodeTag),
(lower, upper, boundary_map)->fileNumber(face2node)),
constraint(hexcells) {
  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<QuadFace*> face_list ;
    std::list<Node*> bnode_list ;
    int nindex ;

    HexCell* aCell = build_hex_cell($lower.begin(), $lower.size(),
                                    $upper.begin(), $upper.size(),
                                    $boundary_map.begin(), $boundary_map.size(),
                                    $hex2face,
                                    $hex2node,
                                    $hexOrientCode,
                                    $*face2node,
                                    $*face2edge,
                                    $*edge2node,
                                    $*pos,
                                    $*edgePlan,
                                    $*facePlan,
                                    $*posTag,
                                    $*nodeTag,
                                    bnode_list,
                                    edge_list,
                                    face_list,
                                    $*fileNumber(face2node)) ;

    std::vector<HexCell*> cells ;
    aCell->resplit( $cellPlan, node_list, edge_list, face_list, cells) ;

    nindex = 0 ;
    for(std::list<Node*>::const_iterator np = node_list.begin(); np!= node_list.end(); np++) {
      (*np)->tag = $nodeTag[nindex++] ;
    }

    int numCells = cells.size() ;
    bool cell_split = false ; // if any cell split, the whole big cell rebalance
    if(numCells != 0) { //aCell is not a leaf
      for(int i=0; i<numCells; i++) {
        if((cells[i]->get_tagged())==1) {
          cells[i]->setSplitCode($split_mode_par, Globals::tolerance) ;
          if(cells[i]->getMySplitCode()!=0) {
            if($split_mode_par == 2) {
              double min_edge_length = cells[i]->get_min_edge_length() ;
              int split_level = Globals::levels ;
              if(Globals::tolerance > 0.0) {
                split_level = int(log(min_edge_length/Globals::tolerance)/log(2.0)) ;
              }

              cells[i]->resplit(min(Globals::levels,split_level),node_list, edge_list, face_list) ;
              cell_split = true ;
            }else {
              cell_split = true ;
              cells[i]->split(node_list, edge_list, face_list) ;
            }
          }
        }
      }
    }else { //aCell is a leaf
      if(aCell->get_tagged() == 1) {
        aCell->setSplitCode($split_mode_par, Globals::tolerance) ;
      }
      if(aCell->getMySplitCode() != 0 ) {
        if($split_mode_par == 2) {
          double min_edge_length = aCell->get_min_edge_length() ;
          int split_level = Globals::levels ;
          if(Globals::tolerance > 0.0) {
            split_level = int(log(min_edge_length/Globals::tolerance)/log(2.0)) ;
          }
          aCell->resplit(min(Globals::levels, split_level), node_list, edge_list, face_list) ;
        }else {
          aCell->split(node_list, edge_list, face_list) ;
        }
      }
    }

    if(cell_split) {
      aCell->rebalance_cells($split_mode_par,node_list, edge_list, face_list) ;
      $newCellPlan = aCell->make_cellplan() ;
    }else {
      // write new cellPlan
      $newCellPlan = aCell->make_cellplan() ;
    }

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($newCellPlan) ;
  }
}


$rule pointwise(newCellPlan <- norestart_tag_par, split_mode_par,
isIndivisible, hex2face, hex2node, hexOrientCode,
(lower, upper, boundary_map)->face2node->(posTag, pos),
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->fileNumber(face2node)),
constraint(hexcells) {
  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<QuadFace*> face_list ;
    std::list<Node*> bnode_list ;

    HexCell* aCell = build_hex_cell($lower.begin(), $lower.size(),
                                    $upper.begin(), $upper.size(),
                                    $boundary_map.begin(), $boundary_map.size(),
                                    $hex2face,
                                    $hex2node,
                                    $hexOrientCode,
                                    $*face2node,
                                    $*face2edge,
                                    $*edge2node,
                                    $*pos,
                                    $*posTag,
                                    bnode_list,
                                    edge_list,
                                    face_list,
                                    $*fileNumber(face2node)) ;

    if(aCell->get_tagged() == 1) {
      aCell->setSplitCode($split_mode_par, Globals::tolerance) ;
    }

    // write new cellPlan
    if(aCell->getMySplitCode() != 0 && $split_mode_par == 2) {
      double min_edge_length =aCell->get_min_edge_length() ;
      int split_level = Globals::levels ;
      if(Globals::tolerance > 0.0) {
        split_level = int(log(min_edge_length/Globals::tolerance)/log(2.0)) ;
      }
      $newCellPlan = aCell->make_cellplan(min(Globals::levels, split_level)) ;
    }else if(aCell->getMySplitCode() != 0 && $split_mode_par != 2) {
      $newCellPlan.push_back(aCell->getMySplitCode()) ;
    }

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(bnode_list, edge_list, face_list) ;
    reduce_vector($newCellPlan) ;
  }
}


//-----------------------------------------------------------------------------
// Rules for XML-region refinement
//-----------------------------------------------------------------------------

$rule pointwise(newCellPlan <- xmlfile_par, split_mode_par,
cellPlan, hex2face, hex2node, hexOrientCode, isIndivisible,
(lower, upper, boundary_map)->(fileNumber(face2node), facePlan),
(lower, upper, boundary_map)->face2node->pos,
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2edge->edgePlan, restart_xml_par,
cellPlanXMLDoc), constraint(hexcells) {
#ifdef USE_LIBXML2
  xmlNode* root_element = xmlDocGetRootElement($*cellPlanXMLDoc->get()) ;
  if(!$isIndivisible) {
    std::list<Edge*> edge_list ;
    std::list<QuadFace*> face_list ;
    std::list<Node*> bnode_list ;
    std::queue<HexCell*> Q ;

    HexCell* aCell = build_hex_cell($lower.begin(), $lower.size(),
                                    $upper.begin(), $upper.size(),
                                    $boundary_map.begin(), $boundary_map.size(),
                                    $hex2face,
                                    $hex2node,
                                    $hexOrientCode,
                                    $*face2node,
                                    $*face2edge,
                                    $*edge2node,
                                    $*pos,
                                    $*edgePlan,
                                    $*facePlan,
                                    bnode_list,
                                    edge_list,
                                    face_list,
                                    $*fileNumber(face2node)) ;

    if(!mark_node(root_element, bnode_list.begin(), bnode_list.end())) {
      cerr << "WARNING: fail to mark nodes, please check xml file" << endl ;
      Loci::Abort() ;
    }

    std::vector<HexCell*> cells ;
    std::list<Node*>::iterator former_pnt = bnode_list.end() ;
    aCell->resplit( $cellPlan, bnode_list, edge_list, face_list, cells) ;
    former_pnt-- ;
    if(!mark_node(root_element, bnode_list.begin(), bnode_list.end())) {
      cerr << "WARNING: fail to mark nodes, please check xml file" << endl ;
      Loci::Abort() ;
    }

    HexCell* current ;
    int numCells = cells.size() ;
    if(numCells != 0) {
      for(int i=0; i<numCells; i++) {
        Q.push(cells[i]) ;
      }
    }else {
      Q.push(aCell) ;
    }

    while(!Q.empty()) {
      current =Q.front() ;
      if(current->get_tagged() == 1) {
        current->setSplitCode($split_mode_par, Globals::tolerance) ;
      }
      if(current->getMySplitCode() != 0) {
        former_pnt = bnode_list.end() ;
        current->split(bnode_list, edge_list, face_list) ;

        former_pnt-- ;
        if(!mark_node(root_element, bnode_list.begin(), bnode_list.end())) {
          cerr << "WARNING: fail to mark nodes, please check xml file" << endl ;
          Loci::Abort() ;
        }

        for(int i=0; i<current->numChildren(); i++) {
          Q.push(current->getChildCell(i)) ;
        }
      }
      Q.pop() ;
    }
    aCell->rebalance_cells($split_mode_par, bnode_list, edge_list, face_list) ;

    // write new cellPlan
    $newCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(bnode_list, edge_list, face_list) ;
    reduce_vector($newCellPlan) ;
  }
#endif
}


$rule pointwise(newCellPlan <- norestart_xml_par, split_mode_par, xmlfile_par,
isIndivisible, hex2face, hex2node, hexOrientCode,
(lower, upper, boundary_map)->face2node->pos,
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->fileNumber(face2node),
cellPlanXMLDoc), constraint(hexcells) {
#ifdef USE_LIBXML2
  xmlNode* root_element = xmlDocGetRootElement($*cellPlanXMLDoc->get()) ;
  if(!$isIndivisible) {
    //std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<QuadFace*> face_list ;
    std::list<Node*> bnode_list ;
    std::queue<HexCell*> Q ;

    HexCell* aCell = build_hex_cell($lower.begin(), $lower.size(),
                                    $upper.begin(), $upper.size(),
                                    $boundary_map.begin(), $boundary_map.size(),
                                    $hex2face,
                                    $hex2node,
                                    $hexOrientCode,
                                    $*face2node,
                                    $*face2edge,
                                    $*edge2node,
                                    $*pos,
                                    bnode_list,
                                    edge_list,
                                    face_list,
                                    $*fileNumber(face2node)) ;

    if(!mark_node(root_element, bnode_list.begin(), bnode_list.end())) {
      cerr<< "WARNING: fail to mark nodes, please check xml file" << endl ;
      Loci::Abort() ;
    }

    Q.push(aCell) ;
    HexCell* current ;
    while(!Q.empty()) {
      current =Q.front() ;
      if(current->get_tagged() == 1) {
        current->setSplitCode($split_mode_par, Globals::tolerance) ;
      }
      // if(current->getMySplitCode() != 0) { cout << "mysplitCode " << char(current->getMySplitCode()+'0') << endl ; }
      if(current->getMySplitCode()!=0) {
        std::list<Node*>::iterator former_pnt = bnode_list.end() ;
        current->split(bnode_list, edge_list, face_list) ;

        former_pnt-- ;
        if(!mark_node(root_element, bnode_list.begin(), bnode_list.end())) {
          cerr << "WARNING: fail to mark nodes, please check xml file" << endl ;
          Loci::Abort() ;
        }

        for(int i=0; i<current->numChildren(); i++) {
          Q.push(current->getChildCell(i)) ;
        }
      }
      Q.pop() ;
    }
    aCell->rebalance_cells($split_mode_par, bnode_list, edge_list, face_list) ;

    // write new cellPlan
    $newCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(bnode_list, edge_list, face_list) ;
    reduce_vector($newCellPlan) ;
  }
#endif
}


//-----------------------------------------------------------------------------
// Rules for parameter-region refinement
//-----------------------------------------------------------------------------

$rule pointwise(newCellPlan <- parfile_par, split_mode_par,
cellPlan, hex2face, hex2node, hexOrientCode, isIndivisible,
(lower, upper, boundary_map)->(fileNumber(face2node), facePlan),
(lower, upper, boundary_map)->face2node->pos,
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2edge->edgePlan, restart_par_par,
cellPlanSources), constraint(hexcells) {
  if(!$isIndivisible) {

    std::list<Edge*> edge_list ;
    std::list<QuadFace*> face_list ;
    std::list<Node*> bnode_list ;
    std::queue<HexCell*> Q ;

    HexCell* aCell = build_hex_cell($lower.begin(), $lower.size(),
                                    $upper.begin(), $upper.size(),
                                    $boundary_map.begin(), $boundary_map.size(),
                                    $hex2face,
                                    $hex2node,
                                    $hexOrientCode,
                                    $*face2node,
                                    $*face2edge,
                                    $*edge2node,
                                    $*pos,
                                    $*edgePlan,
                                    $*facePlan,
                                    bnode_list,
                                    edge_list,
                                    face_list,
                                    $*fileNumber(face2node)) ;

    std::vector<HexCell*> cells ;
    aCell->resplit( $cellPlan, bnode_list, edge_list, face_list, cells) ;

    HexCell* current ;
    int numCells = cells.size() ;
    if(numCells != 0) {
      for(int i=0; i<numCells; i++) {
        Q.push(cells[i]) ;
      }
    }else {
      Q.push(aCell) ;
    }

    while(!Q.empty()) {
      current =Q.front() ;
      if(current->get_tagged(*($*cellPlanSources))) {
        current->split(bnode_list, edge_list, face_list) ;
        for(int i=0; i<current->numChildren(); i++) {
          Q.push(current->getChildCell(i)) ;
        }
      }
      Q.pop() ;
    }
    aCell->rebalance_cells($split_mode_par, bnode_list, edge_list, face_list) ;

    // write new cellPlan
    $newCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(bnode_list, edge_list, face_list) ;
    reduce_vector($newCellPlan) ;
  }
}


$rule pointwise(newCellPlan <- norestart_par_par, split_mode_par, parfile_par,
isIndivisible, hex2face, hex2node, hexOrientCode,
(lower, upper, boundary_map)->face2node->pos,
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->fileNumber(face2node), cellPlanSources),
constraint(hexcells) {
  if(!$isIndivisible) {
    std::list<Edge*> edge_list ;
    std::list<QuadFace*> face_list ;
    std::list<Node*> bnode_list ;
    std::queue<HexCell*> Q ;

    HexCell* aCell = build_hex_cell($lower.begin(), $lower.size(),
                                    $upper.begin(), $upper.size(),
                                    $boundary_map.begin(), $boundary_map.size(),
                                    $hex2face,
                                    $hex2node,
                                    $hexOrientCode,
                                    $*face2node,
                                    $*face2edge,
                                    $*edge2node,
                                    $*pos,
                                    bnode_list,
                                    edge_list,
                                    face_list,
                                    $*fileNumber(face2node)) ;

    Q.push(aCell) ;
    HexCell* current ;
    while(!Q.empty()) {
      current = Q.front() ;

      if(current->get_tagged(*($*cellPlanSources))) {
        current->split(bnode_list, edge_list, face_list) ;
        for(int i=0; i<current->numChildren(); i++) {
          Q.push(current->getChildCell(i)) ;
        }
      }
      Q.pop() ;
    }
    aCell->rebalance_cells($split_mode_par, bnode_list, edge_list, face_list) ;

    // write new cellPlan
    $newCellPlan =  aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(bnode_list, edge_list, face_list) ;
    reduce_vector($newCellPlan) ;
  }
}


//-----------------------------------------------------------------------------
// Rules for cell-tag refinement
//-----------------------------------------------------------------------------

/// Make a newCellPlan according to cellPlan and fineCellTag
$rule pointwise(newCellPlan <- restart_tag_par, split_mode_par,
cellPlan, fineCellTag, hex2face, hex2node, hexOrientCode, isIndivisible,
(lower, upper, boundary_map)->facePlan,
(lower, upper, boundary_map)->face2node->pos,
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2edge->edgePlan,
(lower, upper, boundary_map)->fileNumber(face2node)),
constraint(hexcells) {
  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<QuadFace*> face_list ;
    std::list<Node*> bnode_list ;

    HexCell* aCell = build_hex_cell($lower.begin(), $lower.size(),
                                    $upper.begin(), $upper.size(),
                                    $boundary_map.begin(), $boundary_map.size(),
                                    $hex2face,
                                    $hex2node,
                                    $hexOrientCode,
                                    $*face2node,
                                    $*face2edge,
                                    $*edge2node,
                                    $*pos,
                                    $*edgePlan,
                                    $*facePlan,
                                    bnode_list,
                                    edge_list,
                                    face_list,
                                    $*fileNumber(face2node)) ;

    std::vector<HexCell*> cells ;
    aCell->resplit( $cellPlan, node_list, edge_list, face_list, cells) ;

    int numCells = cells.size() ;
    bool cell_split = false ; // if any cell split, the whole big cell rebalance
    if(numCells != 0) { // aCell is not a leaf
      for(int i=0; i<numCells; i++) {
        if($fineCellTag[i]==1) {
          cells[i]->setSplitCode($split_mode_par, Globals::tolerance) ;
          if(cells[i]->getMySplitCode()!=0) {
            if($split_mode_par == 2) {
              double min_edge_length =cells[i]->get_min_edge_length() ;
              int split_level = Globals::levels ;
              if(Globals::tolerance > 0.0) {
                split_level = int(log(min_edge_length/Globals::tolerance)/log(2.0)) ;
              }
              cells[i]->resplit(min(Globals::levels,split_level),node_list, edge_list, face_list) ;
              cell_split = true ;
            }else {
              cell_split = true ;
              cells[i]->split(node_list, edge_list, face_list) ;
            }
          }
        }
      }
    }else { // aCell is a leaf
      if($fineCellTag[0]==1) {
        aCell->setSplitCode($split_mode_par, Globals::tolerance) ;
      }
      if(aCell->getMySplitCode() != 0 ) {
        if($split_mode_par == 2) {
          double min_edge_length = aCell->get_min_edge_length() ;
          int split_level = Globals::levels ;
          if(Globals::tolerance > 0.0) {
            split_level = int(log(min_edge_length/Globals::tolerance)/log(2.0)) ;
          }
          aCell->resplit(min(Globals::levels, split_level), node_list, edge_list, face_list) ;
        }else {
          aCell->split(node_list, edge_list, face_list) ;
        }
      }
    }

    if(cell_split) {
      aCell->rebalance_cells($split_mode_par,node_list, edge_list, face_list) ;
      $newCellPlan = aCell->make_cellplan() ;
    }else {
      // write new cellPlan
      $newCellPlan = aCell->make_cellplan() ;
    }

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($newCellPlan) ;
  }
}


$rule pointwise(newCellPlan <- norestart_tag_par, split_mode_par,
isIndivisible, cellTag, hex2face, hex2node, hexOrientCode,
(lower, upper, boundary_map)->face2node->pos,
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->fileNumber(face2node)),
constraint(hexcells) {
  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<QuadFace*> face_list ;
    std::list<Node*> bnode_list ;

    HexCell* aCell = build_hex_cell($lower.begin(), $lower.size(),
                                    $upper.begin(), $upper.size(),
                                    $boundary_map.begin(), $boundary_map.size(),
                                    $hex2face,
                                    $hex2node,
                                    $hexOrientCode,
                                    $*face2node,
                                    $*face2edge,
                                    $*edge2node,
                                    $*pos,
                                    bnode_list,
                                    edge_list,
                                    face_list,
                                    $*fileNumber(face2node)) ;

    if($cellTag == 1) {
      aCell->setSplitCode($split_mode_par, Globals::tolerance) ;
    }

    // write new cellPlan
    if(aCell->getMySplitCode() != 0 && $split_mode_par == 2) {
      double min_edge_length =aCell->get_min_edge_length() ;
      int split_level =  Globals::levels ;
      if(Globals::tolerance > 0.0) {
        split_level = int(log(min_edge_length/Globals::tolerance)/log(2.0)) ;
      }
      $newCellPlan = aCell->make_cellplan(min(Globals::levels, split_level)) ;
    }else if(aCell->getMySplitCode() != 0 && $split_mode_par != 2) {
      $newCellPlan.push_back(aCell->getMySplitCode()) ;
    }

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(bnode_list, edge_list, face_list) ;
    reduce_vector($newCellPlan) ;
  }
}
