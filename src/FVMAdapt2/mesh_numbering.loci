#include <Loci.h>
#include <algorithm>
#include <list>
#include <map>
#include <string>
#include <vector>

#include "defines.h"

$include "FVM.lh"
$include "fvmadapt_internal.lh"

using std::cerr ;
using std::cout ;
using std::endl ;
using std::list ;
using std::ofstream ;
using std::pair ;
using std::sort ;
using std::string;
using std::unique ;
using std::vector ;

using Loci::MPI_processes ;

$type X store<Loci::real_t> ;

//-----------------------------------------------------------------------------
// Generic file numbering
//-----------------------------------------------------------------------------

$rule pointwise(fileNumber(X)), constraint(X), option(disable_threading),
prelude {
  fact_db::distribute_infoP df = Loci::exec_current_fact_db->get_distribute_info() ;
  if(df == 0) {
    for(sequence::const_iterator si=seq.begin();si!= seq.end();++si) {
      $fileNumber(X)[*si] = *si ;
    }
  }else {
    Map l2f ;
    l2f = df->l2f.Rep() ;

    for(sequence::const_iterator si=seq.begin();si!= seq.end();++si) {
      $fileNumber(X)[*si] = l2f[*si] ;
    }
  }
} ;


//-----------------------------------------------------------------------------
// Original-node count
//-----------------------------------------------------------------------------

$rule unit(num_original_nodes), constraint(UNIVERSE) {
  //parameter, no loop,
  $num_original_nodes = 0 ;
}

$rule apply(num_original_nodes <- pos, num_original_nodes)[Loci::Summation] {
  int count = 1 ;
  join($num_original_nodes, count) ;
}


//-----------------------------------------------------------------------------
// Original-face count
//-----------------------------------------------------------------------------

$rule unit(num_original_faces), constraint(UNIVERSE) {
  // parameter, no loop,
  $num_original_faces = 0 ;
}

$rule apply(num_original_faces <- face2node, num_original_faces)[Loci::Summation],
constraint(faces) {
  int count = 1 ;
  join($num_original_faces, count) ;
}
