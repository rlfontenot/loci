#include <iostream>
#include <vector>
#include <Loci.h>
#include <Tools/tools.h>
#include "prism.h"

$include "FVM.lh"
$include "fvmadapt_internal.lh"

using std::cerr ;
using std::endl ;
using std::vector ;
using Loci::storeRepP ;

// by: Qiuhan Xue
//
// This file generate  fine_faces according refinement plans. The
// original grid is prism element. Anisotropic refinement is used. the rules should be
// used After node_offset and cell_offset has been set up.
// FineFaces is defined as c1, c2,followed by face2node.


/// Get fine_faces of prism cells
$rule pointwise(fine_faces_cell <- balancedCellPlan,
balanced_node_offset, balanced_cell_offset,
prism2face, prism2node, prismOrientCode,
(lower, upper, boundary_map)->(balancedFacePlan, balanced_node_offset),
(lower, upper, boundary_map)->face2edge->(balancedEdgePlan,
                                          balanced_node_offset),
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->fileNumber(face2node)),
constraint(prisms) {

  if($balancedCellPlan.size() == 0) {
    vector<vector<int> >().swap($fine_faces_cell) ;
    return ;
  }

  std::list<Node*> bnode_list ; //boundary node
  std::list<Edge*> edge_list ;
  std::list<QuadFace*> qface_list ;
  std::list<Face*> gface_list ;
  std::list<Node*> node_list ; //inner node
  int c1, c2 ;

  // build a Cell
  Prism* aCell = build_prism_cell($lower.begin(), $lower.size(),
                                  $upper.begin(), $upper.size(),
                                  $boundary_map.begin(), $boundary_map.size(),
                                  $prism2face,
                                  $prism2node,
                                  $prismOrientCode,
                                  $*face2node,
                                  $*face2edge,
                                  $*edge2node,
                                  $*pos,
                                  $*balancedEdgePlan,
                                  $*balancedFacePlan,
                                  $*balanced_node_offset,
                                  $*fileNumber(face2node),
                                  $*fileNumber(pos),
                                  bnode_list,
                                  edge_list,
                                  qface_list,
                                  gface_list) ;

  std::vector<Prism*> cells ;
  aCell->resplit($balancedCellPlan, node_list, edge_list, qface_list, gface_list, cells) ;

  // and index the nodes
  int nindex = 0 ;
  for(std::list<Node*>::const_iterator np = node_list.begin(); np!= node_list.end(); np++, nindex++) {
    (*np)->index = $balanced_node_offset + nindex ;
  }

  // set up inner faces
  std::map<QuadFace*, NeibIndex> inner_qfaces ;
  std::map<Face*, NeibIndex> inner_gfaces ;
  set_prism_faces(cells,inner_qfaces, inner_gfaces) ;

  // put inner faces into fine_faces[cc]
  std::vector<std::vector<int> >(inner_qfaces.size()+inner_gfaces.size()).swap($fine_faces_cell) ;

  int fptr = 0 ;
  for(std::map<QuadFace*, NeibIndex>::const_iterator pf = inner_qfaces.begin();
      pf != inner_qfaces.end(); pf++,fptr++) {

    // face2node is store in faceVertex
    std::list<int32> faceVertex ;

    //for each face, set up face2node
    pf->first->set_f2n(faceVertex) ;

    // transfer c1 , c2 from local(inside a original cell) numbering  to file numbering
    c2 = (pf->second).c2 + $balanced_cell_offset ;
    c1 = (pf->second).c1 + $balanced_cell_offset ;

    // put c1, c2 and faceVertex into one vector
    int vec_size = faceVertex.size() + 2 ;
    std::vector<int>(vec_size).swap($fine_faces_cell[fptr]) ;
    $fine_faces_cell[fptr][0] = c1 ;
    $fine_faces_cell[fptr][1] = c2 ;

    std::list<int32>::const_iterator nptr = faceVertex.begin() ;
    for(int i=2; i<vec_size; i++,nptr++) {
      $fine_faces_cell[fptr][i] = *nptr ;
    }
  }

  for(std::map<Face*, NeibIndex>::const_iterator pf = inner_gfaces.begin();
      pf != inner_gfaces.end(); pf++,fptr++) {

    // face2node is store in faceVertex
    std::list<int32> faceVertex ;

    // for each face, set up face2node
    pf->first->set_f2n(faceVertex) ;

    // transfer c1 , c2 from local(inside a original cell) numbering  to file numbering
    c2 = (pf->second).c2 + $balanced_cell_offset ;
    c1 = (pf->second).c1 + $balanced_cell_offset ;

    // put c1, c2 and faceVertex into one vector
    int vec_size = faceVertex.size() + 2 ;
    std::vector<int>(vec_size).swap($fine_faces_cell[fptr]) ;
    $fine_faces_cell[fptr][0] = c1 ;
    $fine_faces_cell[fptr][1] = c2 ;

    std::list<int32>::const_iterator nptr = faceVertex.begin() ;
    for(int i = 2; i < vec_size; i++,nptr++) {
      $fine_faces_cell[fptr][i] = *nptr ;
    }
  }

  // clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  // aCell will clean up these
  cleanup_list(bnode_list, edge_list, qface_list) ;
  cleanup_list(gface_list) ;
  cleanup_list(node_list) ;
}


/// Get fine_faces of interior faces
$rule pointwise(fine_faces <- balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
(cl, cr)->(balancedCellPlan, balanced_cell_offset,
           prism2node, prism2face, prismOrientCode), fl, fr,
(cl, cr)->(upper, lower, boundary_map)->face2node->pos,
(cl, cr)->(upper, lower, boundary_map)->face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos))),
constraint((cl, cr)->prisms) {

  std::vector<QuadFace*> fine_qfaces ;
  std::vector<Face*> fine_gfaces ;
  QuadFace* aqFace = 0 ;
  Face* agFace = 0 ;
  unsigned int num_leaves = 0 ;

  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  std::list<int32> faceVertex ;
  int c1, c2 ;

  if($face2node.size() == 4) {
    aqFace = build_quad_face($face2node.begin(),
                             $face2edge.begin(),
                             $*edge2node,
                             $*pos,
                             $*balancedEdgePlan,
                             $*balanced_node_offset,
                             $*fileNumber(pos),
                             bnode_list,
                             edge_list) ;

    if($balancedFacePlan.size() == 0) {
      // num of fine faces is 1
      aqFace->set_f2n(faceVertex) ;
      vector<vector<int> >(1).swap($fine_faces) ;
      int vec_size = faceVertex.size() + 2 ;
      vector<int>(vec_size).swap($fine_faces[0]) ;

      // get c1, c2(local numbering start with 1)
      c1 = $cl->$balanced_cell_offset + 1 ;
      c2 = $cr->$balanced_cell_offset + 1 ;

      $fine_faces[0][0] = c1 ;
      $fine_faces[0][1] = c2 ;

      std::list<int32>::const_iterator nptr = faceVertex.begin() ;
      for(int i=2; i<vec_size; i++, nptr++) {
        $fine_faces[0][i] = *nptr ;
      }
      // clean up
      if(aqFace != 0) { delete aqFace ; }
      cleanup_list(bnode_list, edge_list) ;
      return ;
    }

    // split the face
    aqFace->resplit($balancedFacePlan, char(0), node_list, edge_list, fine_qfaces) ;
    num_leaves = fine_qfaces.size() ;
  }else {
    agFace = build_general_face($face2node.begin(),$face2node.size(),
                                $face2edge.begin(),
                                $*edge2node,
                                $*pos,
                                $*balanced_node_offset,
                                $*balancedEdgePlan,
                                bnode_list,
                                edge_list,
                                $*fileNumber(pos)) ;

    if($balancedFacePlan.size() == 0) {
      // num of fine faces is 1
      agFace->set_f2n(faceVertex) ;
      vector<vector<int> >(1).swap($fine_faces) ;
      int vec_size = faceVertex.size() + 2 ;
      vector<int>(vec_size).swap($fine_faces[0]) ;

      // get c1, c2(local numbering start with 1)
      // c1 = cell_offset[cl[f]] + 1 ;
      // c2 = cell_offset[cr[f]] + 1 ;
      std::vector<int32> CL = get_c1_prism($cl->$balancedCellPlan,
                                           $balancedFacePlan,
                                           $cl->$prismOrientCode[$fl],
                                           $fl) ;

      if( CL.size()!= 1) {
        cerr << "WARNING: CL has the incorrect size" << endl ;
        Loci::Abort() ;
      }

      std::vector<int32> CR = get_c1_prism($cr->$balancedCellPlan,
                                           $balancedFacePlan,
                                           $cr->$prismOrientCode[$fr],
                                           $fr) ;

      if(CR.size() != 1) {
        cerr << "WARNING: CR has the incorrect size" << endl ;
        Loci::Abort() ;
      }
      c1 = $cl->$balanced_cell_offset + CL[0] ;
      c2 = $cr->$balanced_cell_offset + CR[0] ;
      $fine_faces[0][0] = c1 ;
      $fine_faces[0][1] = c2 ;

      std::list<int32>::const_iterator nptr = faceVertex.begin() ;
      for(int i=2; i<vec_size; i++, nptr++) {
        $fine_faces[0][i] = *nptr ;
      }

      // clean up
      if(agFace != 0) { delete agFace ; }
      cleanup_list(bnode_list, edge_list) ;
      return ;
    }

    // split the face
    agFace->resplit($balancedFacePlan, node_list, edge_list, fine_gfaces) ;
    num_leaves = fine_gfaces.size() ;
  }

  // and index the node_list
  int nindex = 0 ;
  for(std::list<Node*>::const_iterator np = node_list.begin(); np!= node_list.end(); np++,nindex++) {
    (*np)->index = $balanced_node_offset + nindex ;
  }

  // get CL and CR
  std::vector<int32> CL = get_c1_prism($cl->$balancedCellPlan,
                                       $balancedFacePlan,
                                       $cl->$prismOrientCode[$fl],
                                       $fl) ;

  if(num_leaves != CL.size()){
    cerr << "WARNING: CL has the incorrect size" << endl ;
    Loci::Abort() ;
  }

  std::vector<int32> CR = get_c1_prism($cr->$balancedCellPlan,
                                       $balancedFacePlan,
                                       $cr->$prismOrientCode[$fr],
                                       $fr) ;

  if(num_leaves != CR.size()) {
    cerr << "WARNING: CR has the incorrect size" << endl ;
    Loci::Abort() ;
  }

  // set the size of fine_faces[f]
  vector<std::vector<int> >(num_leaves).swap($fine_faces) ;

  // set fine_faces[f]
  for(unsigned int fptr=0; fptr<num_leaves; fptr++) {
    // set c1
    if($cl->$balancedCellPlan.size() == 0) {
      c1 = $cl->$balanced_cell_offset + 1 ;
    }else {
      c1 = $cl->$balanced_cell_offset + CL[fptr] ;
    }

    // set c2
    if($cr->$balancedCellPlan.size() == 0) {
      c2 = $cr->$balanced_cell_offset + 1 ;
    }else {
      c2 = $cr->$balanced_cell_offset + CR[fptr] ;
    }

    // set faceVertex
    faceVertex.clear() ;
    if($face2node.size() == 4) {
      fine_qfaces[fptr]->set_f2n(faceVertex) ;
    }else {
      fine_gfaces[fptr]->set_f2n(faceVertex) ;
    }

    int vec_size = faceVertex.size() + 2 ;
    vector<int>(vec_size).swap($fine_faces[fptr]) ;
    $fine_faces[fptr][0] = c1 ;
    $fine_faces[fptr][1] = c2 ;
    std::list<int32>::const_iterator nptr = faceVertex.begin() ;

    for(int i=2; i<vec_size; i++,nptr++) {
      $fine_faces[fptr][i] = *nptr ;
    }
  }

  // clean up
  if(aqFace != 0) {
    delete aqFace ;
    aqFace = 0 ;
  }

  if(agFace != 0) {
    delete agFace ;
    agFace = 0 ;
  }
  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}


/// Get fine_faces of boundary faces
$rule pointwise(fine_faces <- balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
cl->(balancedCellPlan, balanced_cell_offset,
     prism2face, prism2node, prismOrientCode), fl,
cl->(upper, lower, boundary_map)->face2node->pos,
cl->(upper, lower, boundary_map)->face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos)), ref->boundary_tags),
constraint(cl->prisms, boundary_faces) {

  std::vector<QuadFace*> fine_qfaces ;
  std::vector<Face*> fine_gfaces ;
  QuadFace* aqFace = 0;
  Face* agFace = 0 ;
  unsigned int num_leaves = 0 ;

  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  std::list<int32> faceVertex ;
  int c1 ;

  int c2 = -atoi(&($ref->$boundary_tags[3])) ;

  // build a face
  if($face2node.size() == 4){
    aqFace = build_quad_face($face2node.begin(),
                             $face2edge.begin(),
                             $*edge2node,
                             $*pos,
                             $*balancedEdgePlan,
                             $*balanced_node_offset,
                             $*fileNumber(pos),
                             bnode_list,
                             edge_list) ;

    if($balancedFacePlan.size() == 0) {
      // num of fine faces is 1
      vector< std::vector<int> >(1).swap($fine_faces) ;

      aqFace->set_f2n(faceVertex) ;
      int vec_size = faceVertex.size() + 2 ;
      std::vector<int>(vec_size).swap($fine_faces[0]) ;

      // get c1
      c1 = $cl->$balanced_cell_offset + 1 ;

      $fine_faces[0][0] = c1 ;
      $fine_faces[0][1] = c2 ;

      std::list<int32>::const_iterator nptr = faceVertex.begin() ;
      for(int i=2; i<vec_size; i++,nptr++) {
        $fine_faces[0][i] = *nptr ;
      }

      // clean up
      if(aqFace != 0) {
        delete aqFace ;
        aqFace = 0 ;
      }
      cleanup_list(bnode_list, edge_list) ;
      return ;
    }

    // split the face
    aqFace->resplit($balancedFacePlan, char(0), node_list, edge_list, fine_qfaces) ;
    num_leaves = fine_qfaces.size() ;
  }else {
    agFace = build_general_face($face2node.begin(),$face2node.size(),
                                $face2edge.begin(),
                                $*edge2node,
                                $*pos,
                                $*balanced_node_offset,
                                $*balancedEdgePlan,
                                bnode_list,
                                edge_list,
                                $*fileNumber(pos)) ;

    if($balancedFacePlan.size() == 0) {
      // num of fine faces is 1
      agFace->set_f2n(faceVertex) ;
      vector<vector<int> >(1).swap($fine_faces) ;
      int vec_size = faceVertex.size() + 2 ;
      vector<int>(vec_size).swap($fine_faces[0]) ;

      // get c1, c2(local numbering start with 1)

      // get CL
      std::vector<int32> CL = get_c1_prism($cl->$balancedCellPlan,
                                          $balancedFacePlan,
                                          $cl->$prismOrientCode[$fl],
                                          $fl) ;

      if(CL.size()!= 1) {
        cerr << "WARNING: CL has the incorrect size" << endl ;
        Loci::Abort() ;
      }

      c1 = $cl->$balanced_cell_offset + CL[0] ;

      $fine_faces[0][0] = c1 ;
      $fine_faces[0][1] = c2 ;

      std::list<int32>::const_iterator nptr = faceVertex.begin() ;
      for(int i=2; i<vec_size; i++, nptr++) {
        $fine_faces[0][i] = *nptr ;
      }

      // clean up
      if(agFace != 0) {
        delete agFace ;
        agFace = 0 ;
      }
      cleanup_list(bnode_list, edge_list) ;
      return ;
    }

    // split the face
    agFace->resplit($balancedFacePlan, node_list, edge_list, fine_gfaces) ;
    num_leaves = fine_gfaces.size() ;
  }

  // and index the node_list
  int nindex = 0 ;
  for(std::list<Node*>::const_iterator np = node_list.begin(); np!= node_list.end(); np++,nindex++) {
      (*np)->index = $balanced_node_offset + nindex ;
  }

  //get CL
  std::vector<int32> CL = get_c1_prism($cl->$balancedCellPlan,
                                       $balancedFacePlan,
                                       $cl->$prismOrientCode[$fl],
                                       $fl) ;

  if(num_leaves != CL.size()) {
    cerr << "WARNING: CL has the incorrect size" << endl ;
    Loci::Abort() ;
  }

  vector<vector<int> >(num_leaves).swap($fine_faces) ;
  // set face_vertices
  for(unsigned int fptr=0; fptr<num_leaves; fptr++) {
    faceVertex.clear() ;
    if($face2node.size()==4) {
      fine_qfaces[fptr]->set_f2n(faceVertex) ;
    }else {
      fine_gfaces[fptr]->set_f2n(faceVertex) ;
    }

    // set c1
    if($cl->$balancedCellPlan.size() == 0) {
      c1 = $cl->$balanced_cell_offset + 1 ;
    }else {
      c1 = $cl->$balanced_cell_offset + CL[fptr] ;
    }

    int vec_size = faceVertex.size() + 2 ;
    vector<int>(vec_size).swap($fine_faces[fptr]) ;
    $fine_faces[fptr][0] = c1 ;
    $fine_faces[fptr][1] = c2 ;

    std::list<int32>::const_iterator nptr = faceVertex.begin() ;
    for(int i=2; i<vec_size; i++, nptr++) {
      $fine_faces[fptr][i] = *nptr ;
    }
  }

  // clean up
  if(aqFace != 0) {
    delete aqFace ;
    aqFace = 0 ;
  }

  if(agFace != 0) {
    delete agFace ;
    agFace = 0 ;
  }

  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}
