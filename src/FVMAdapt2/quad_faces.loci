#include <queue>

#include "quadface.h"
#include "hex_defines.h"
$include "FVM.lh"
$include "fvmadapt_internal.lh"

using std::cout ;
using std::endl ;

$type quadrangles Constraint ;

// dummy rules to create constraint quadface

$rule pointwise(quadfaces), constraint(boundary_faces, cl->hexcells) {}


$rule pointwise(quadfaces),
constraint(boundary_faces, quadrangles, cl->prisms) {}


$rule pointwise(priority::cr::quadfaces),
constraint(interior_faces, quadrangles, cl->prisms) {}


$rule pointwise(priority::cr::quadfaces),
constraint(interior_faces, cl->hexcells) {}


$rule pointwise(cr::quadfaces),
constraint(interior_faces, quadrangles, cr->prisms) {}


$rule pointwise(cr::quadfaces),
constraint(interior_faces, cr->hexcells) {}


// Rule to check if a face is quadface
$rule pointwise(quadfaces::is_quadface), constraint(faces) {
  $is_quadface = false ;
}


$rule pointwise(priority::quadfaces::is_quadface), constraint(quadfaces) {
  //std::cout << "quadface in a rule: " << seq.size() << " myID " << Loci::MPI_rank << std::endl ;
  $is_quadface = true ;
}
