#include <Loci.h>
#include <vector>
#include "defines.h"
#include "dataxferDB.h"
using std::cout;
using std::endl;
using std::string;
using std::ifstream;

$include "FVM.lh"
$include "fvmadapt_internal.lh"

namespace Loci {
  storeRepP Local2FileOrder(storeRepP sp, entitySet dom, int &offset,
                            fact_db::distribute_infoP dist, MPI_Comm comm) ;

  void File2LocalOrder(storeRepP &result, entitySet resultSet,
                       storeRepP input, int offset,
                       fact_db::distribute_infoP dist,
                       MPI_Comm comm) ;
}

$type tmpPlan store<std::vector<char> > ;
$type balanced_planDB_par param<std::string> ;
$type balanced_planfile_par param<std::string> ;
$type parent_planfile_par param<std::string> ;
$type parent_planDB_par param<std::string> ;
$type plan_outfile_par param<std::string> ;
$type plan_outDB_par param<std::string> ;
$type cellplan_output store<bool> ;
$type cellweight_outDB_par param<std::string> ;
$type cellweight_output store<bool> ;

//-----------------------------------------------------------------------------
// Rules for current cell-plan input
//-----------------------------------------------------------------------------

/// Load the current cell plan from a plan file and restore serialized empty
/// plans.
$rule pointwise(cellPlan <- planfile_par), constraint(geom_cells),
option(disable_threading), prelude {
  hid_t file_id ;
  entitySet dom = entitySet(seq) ;
  file_id = H5Fopen((*$planfile_par).c_str(), H5F_ACC_RDONLY,
                    H5P_DEFAULT) ;

  Loci::readContainer(file_id,"cellPlan",$cellPlan.Rep(),dom) ;
  H5Fclose(file_id) ;
}compute {
  if($cellPlan.size() == 1 && $cellPlan[0] == 'C') { $cellPlan.resize(0) ; }
}

/// Load the current cell plan from the transfer database and map it to local
/// cell order.
$rule pointwise(cellPlan <- planDB_par), constraint(geom_cells),
option(disable_threading), prelude {
  entitySet dom = entitySet(seq);
  store<std::vector<char> > readPlan ;

  readPlan = Loci::DataXFER_DB.getItem((*$planDB_par).c_str()) ;

  fact_db::distribute_infoP dist = Loci::exec_current_fact_db->get_distribute_info() ;
  if(dist==0) {
    FORALL(dom,ii) {
      $cellPlan[ii] = readPlan[ii] ;
    } ENDFORALL ;
  }else {
    store<std::vector<char> > tmp ;
    tmp.allocate(dom) ;
    Loci::storeRepP tmpRep = tmp.Rep() ;
    int offset = 0 ;
    File2LocalOrder(tmpRep,dom,readPlan.Rep(),offset,dist,MPI_COMM_WORLD) ;
    FORALL(dom,ii) {
      $cellPlan[ii].swap(tmp[ii]) ;
    } ENDFORALL ;
  }

  FORALL(dom,cc) {
    if($cellPlan[cc].size() == 1 && $cellPlan[cc][0] == 'C') {
      $cellPlan[cc].resize(0) ;
    }
  } ENDFORALL ;
} ;


//-----------------------------------------------------------------------------
// Rules for balanced cell-plan input
//-----------------------------------------------------------------------------

/// Load a balanced cell plan from the transfer database when
/// balanced_planDB_par exists. The existence of this input fact is what
/// controls whether this rule is active or not. This rule handles loading
/// a balanced cell plan from the transfer database.
$rule pointwise(priority::refmesh::balancedCellPlan <- balanced_planDB_par),
constraint(geom_cells), option(disable_threading), prelude {
  entitySet dom = entitySet(seq);
  store<std::vector<char> > readPlan ;

  readPlan = Loci::DataXFER_DB.getItem((*$balanced_planDB_par).c_str()) ;

  fact_db::distribute_infoP dist = Loci::exec_current_fact_db->get_distribute_info() ;
  if(dist==0) {
    FORALL(dom,ii) {
      $balancedCellPlan[ii] = readPlan[ii] ;
    } ENDFORALL ;
  }else {
    store<std::vector<char> > tmp ;
    tmp.allocate(dom) ;
    Loci::storeRepP tmpRep = tmp.Rep() ;
    int offset = 0 ;
    File2LocalOrder(tmpRep,dom,readPlan.Rep(),offset,dist,MPI_COMM_WORLD) ;
    FORALL(dom,ii) {
      $balancedCellPlan[ii].swap(tmp[ii]) ;
    } ENDFORALL ;
  }

  FORALL(dom,cc) {
    if($balancedCellPlan[cc].size() == 1 && $balancedCellPlan[cc][0] == 'C') {
      $balancedCellPlan[cc].resize(0) ;
    }
  } ENDFORALL ;
} ;

/// Load a balanced cell plan from a file when balanced_planfile_par is
/// provided to the module. This rule handled loading a balanced cell plan
/// from an HDF5 file.
$rule pointwise(priority::refmesh::balancedCellPlan <- balanced_planfile_par),
constraint(geom_cells), option(disable_threading), prelude {
  hid_t file_id;
  entitySet dom = entitySet(seq);
  file_id = H5Fopen((*$balanced_planfile_par).c_str(), H5F_ACC_RDONLY,
                    H5P_DEFAULT);

  Loci::readContainer(file_id,"cellPlan",$balancedCellPlan.Rep(),dom) ;
  H5Fclose(file_id);
}compute {
  if($balancedCellPlan.size() == 1 && $balancedCellPlan[0] == 'C')
    $balancedCellPlan.resize(0);
}


//-----------------------------------------------------------------------------
// Rules for parent cell-plan input
//-----------------------------------------------------------------------------

/// Load the previous mesh's cell plan from a file for cell-to-parent mapping.
$rule pointwise(parentPlan <- parent_planfile_par), constraint(geom_cells),
option(disable_threading), prelude {
  hid_t file_id ;
  entitySet dom = entitySet(seq) ;
  file_id = H5Fopen((*$parent_planfile_par).c_str(), H5F_ACC_RDONLY,
                    H5P_DEFAULT) ;

  Loci::readContainer(file_id,"cellPlan",$parentPlan.Rep(),dom) ;
  H5Fclose(file_id) ;
}compute {
  if($parentPlan.size() == 1 && $parentPlan[0] == 'C') { $parentPlan.resize(0) ; }
}

/// Load the previous mesh's cell plan from the transfer database for
/// cell-to-parent mapping.
$rule pointwise(parentPlan <- parent_planDB_par), constraint(geom_cells),
option(disable_threading), prelude {
  entitySet dom = entitySet(seq) ;
  store<std::vector<char> > readPlan ;

  readPlan = Loci::DataXFER_DB.getItem((*$parent_planDB_par).c_str()) ;

  fact_db::distribute_infoP dist = Loci::exec_current_fact_db->get_distribute_info() ;
  if(dist==0) {
    FORALL(dom,ii) {
      $parentPlan[ii]= readPlan[ii] ;
    } ENDFORALL ;
  }else {
    store<std::vector<char> > tmp ;
    tmp.allocate(dom) ;
    Loci::storeRepP tmpRep = tmp.Rep() ;
    int offset = 0 ;
    File2LocalOrder(tmpRep,dom,readPlan.Rep(),offset,dist,MPI_COMM_WORLD) ;
    FORALL(dom,ii) {
      $parentPlan[ii].swap(tmp[ii]) ;
    } ENDFORALL ;
  }

  FORALL(dom,cc) {
    if($parentPlan[cc].size() == 1 && $parentPlan[cc][0] == 'C') {
      $parentPlan[cc].resize(0) ;
    }
  } ENDFORALL ;
} ;


//-----------------------------------------------------------------------------
// Rules for cell-plan output
//-----------------------------------------------------------------------------

/// Prepare a balanced cell plan for output, using 'C' to represent an empty
/// plan.
$rule pointwise(tmpPlan <- balancedCellPlan), option(disable_threading) {
  if($balancedCellPlan.size() == 0) {
    $tmpPlan.push_back('C') ;
  }else {
    $tmpPlan = $balancedCellPlan ;
  }
}

/// Write the prepared cell plans to the file specified by plan_outfile_par.
$rule pointwise(cellplan_output <- tmpPlan, plan_outfile_par),
constraint(geom_cells), option(disable_threading), prelude {
  hid_t file_id ;

  file_id = Loci::hdf5CreateFile((*$plan_outfile_par).c_str(),H5F_ACC_TRUNC,
                                 H5P_DEFAULT, H5P_DEFAULT) ;

  if(Loci::MPI_rank == 0) {
    cout << "writing cellplan into " << *$plan_outfile_par << endl ;
  }
  Loci::writeContainer(file_id,"cellPlan",$tmpPlan.Rep()) ;
  Loci::hdf5CloseFile(file_id) ;
  if(Loci::MPI_rank == 0) {
    cout << "Finish writing cellPlan " << endl ;
  }
} ;

/// Store the prepared cell plans in the transfer database under the key
/// specified by plan_outDB_par.
$rule pointwise(cellplan_output <- tmpPlan, plan_outDB_par),
constraint(geom_cells), option(disable_threading), prelude {
  entitySet dom = entitySet(seq) ;

  fact_db::distribute_infoP dist = Loci::exec_current_fact_db->get_distribute_info() ;
  if(dist==0) {
    store<std::vector<char> > pcopy ;
    pcopy.allocate(dom) ;
    FORALL(dom,ii) {
      pcopy[ii] = $tmpPlan[ii] ;
    } ENDFORALL ;

    Loci::DataXFER_DB.insertItem((*$plan_outDB_par).c_str(),pcopy.Rep()) ;
  }else {
    int offset = 0 ;
    Loci::storeRepP vardist = Loci::Local2FileOrder($tmpPlan.Rep(),dom,offset,
                                                    dist,
                                                    MPI_COMM_WORLD) ;
    vardist->shift(offset) ;
    Loci::DataXFER_DB.insertItem((*$plan_outDB_par).c_str(),vardist) ;
  }
} ;

//-----------------------------------------------------------------------------
// Rules for cell-weight output
//-----------------------------------------------------------------------------

//$type cellweight_outfile_par param<std::string> ;
/// Cell-weight file output is currently unused. Online adaptation stores these
/// weights in the transfer database through the rule below.
//$rule pointwise(cellweight_output <- cellweight_outfile_par,
//balanced_num_fine_cells), constraint(geom_cells), option(disable_threading),
//prelude {
//  hid_t file_id ;
//  file_id = Loci::hdf5CreateFile((*$cellweight_outfile_par).c_str(),
//                                 H5F_ACC_TRUNC, H5P_DEFAULT, H5P_DEFAULT) ;
//  Loci::writeContainer(file_id,"cellweights",
//                       $balanced_num_fine_cells.Rep()) ;
//  Loci::hdf5CloseFile(file_id) ;
//} ;

/// Store each cell's final fine-cell count in the transfer database for use
/// as a mesh-partitioning weight.
$rule pointwise(cellweight_output <- balanced_num_fine_cells,
cellweight_outDB_par), constraint(geom_cells), option(disable_threading),
prelude {
  entitySet dom = entitySet(seq);

  fact_db::distribute_infoP dist = Loci::exec_current_fact_db->get_distribute_info() ;
  if(dist==0) {
    store<int> pcopy ;
    pcopy.allocate(dom) ;
    FORALL(dom,ii) {
      pcopy[ii] = $balanced_num_fine_cells[ii] ;
    } ENDFORALL ;

    Loci::DataXFER_DB.insertItem((*$cellweight_outDB_par).c_str(),pcopy.Rep()) ;
  }else {
    int offset = 0 ;
    Loci::storeRepP vardist = Loci::Local2FileOrder($balanced_num_fine_cells.Rep(),
                                                    dom,offset,dist,
                                                    MPI_COMM_WORLD) ;
    vardist->shift(offset) ;
    Loci::DataXFER_DB.insertItem((*$cellweight_outDB_par).c_str(),vardist) ;
  }
} ;
