#include <Loci.h>
#include <Tools/tools.h>
#include "FVMOverset/overset.h"
#include "FVMMod/geometry/geomPrimitives.h"
#include <iostream>
#include <fstream>
#include <string>
using std::string ;
using std::endl ;
using std::cout ;
using std::cerr ;
using std::ifstream ;
using std::ios ;
#include <vector>
using std::vector ;
#include <map>
using std::map ;
#include <set>
using std::set ;

$include "FVM.lh"
$include "FVMOverset/overset.lh"

namespace Loci {

  /// Specifies hole cutting geometry for overset grids
  $rule optional(componentGeometry) {}


  /// Unit/apply rules to parse the componentGeometry options_list and fill the
  /// componentGeometryData map. This map contains the names of the specified
  /// component geometry names and their specified geometry_types. This is a
  /// rule that is used for hole cutting purposes.
  $rule unit(componentGeometryData),constraint(UNIVERSE), prelude {
    *$componentGeometryData = map<string,Loci::CPTR<geometry_type> >() ;
  } ;

  $rule apply(componentGeometryData<-componentGeometry)[Loci::NullOp],
        prelude  {
    std::vector<Loci::CPTR<geometry_type> > geomList ;
    std::vector<std::string> geomTypes ;
    std::vector<std::string> geomNames ;
    const options_list &ol = *$componentGeometry ;
    options_list::option_namelist nl = ol.getOptionNameList() ;
    options_list::option_namelist::const_iterator nli ;
    for(nli=nl.begin();nli!=nl.end();++nli) {
     // note this needs another loop for multiple overset sub descriptions
      string tag = *nli;
      string gname; // local name for geometry type
      geomNames.push_back(tag) ;
      Loci::options_list::arg_list value_list;
      ol.getOption(tag,value_list);
      // std::cout << "tagsgggs " << tag << endl;
      // std::cout << "value list size " << value_list.size() << endl;
      for (size_t i = 0, sz = value_list.size(); i < sz; ++i) {
        // std::cout << "value list info " << value_list[i] << endl;
        // std::cout << "value list type " << value_list[i].type_of() << endl;
        if (value_list[i].type_of() != FUNCTION) {
          cerr << "geometry for component '" << tag
               << "' must be a function" << endl ;
          Loci::Abort() ;
        }
        value_list[i].get_value(gname) ;
        geomTypes.push_back(gname);
        // std::cout << "fname " << fname << endl;

        options_list::arg_list shape;
        value_list[i].get_value(shape);
        options_list fol;
        fol.Input(shape);
        std::cout << fol << endl;
        if(gname == "hex") {
          vector3d<real_t> p0(0,0,0) ;
          if(fol.optionExists("p0"))
            fol.getOptionUnits("p0","m",p0) ;
          else
            cerr << "p0 not defined in hex geometry"<< endl ;
          vector3d<real_t> p1(0,0,0) ;
          if(fol.optionExists("p1"))
            fol.getOptionUnits("p1","m",p1) ;
          else
            cerr << "p1 not defined in hex geometry"<< endl ;
          vector3d<real_t> p2(0,0,0) ;
          if(fol.optionExists("p2"))
            fol.getOptionUnits("p2","m",p2) ;
          else
            cerr << "p2 not defined in hex geometry"<< endl ;
          vector3d<real_t> p3(0,0,0) ;
          if(fol.optionExists("p3"))
            fol.getOptionUnits("p3","m",p3) ;
          else
            cerr << "p3 not defined in hex geometry"<< endl ;
          vector3d<real_t> p4(0,0,0) ;
          if(fol.optionExists("p4"))
            fol.getOptionUnits("p4","m",p4) ;
          else
            cerr << "p4 not defined in hex geometry"<< endl ;
          vector3d<real_t> p5(0,0,0) ;
          if(fol.optionExists("p5"))
            fol.getOptionUnits("p5","m",p5) ;
          else
            cerr << "p5 not defined in hex geometry"<< endl ;
          vector3d<real_t> p6(0,0,0) ;
          if(fol.optionExists("p6"))
            fol.getOptionUnits("p6","m",p6) ;
          else
            cerr << "p6 not defined in hex geometry"<< endl ;
          vector3d<real_t> p7(0,0,0) ;
          if(fol.optionExists("p7"))
            fol.getOptionUnits("p7","m",p7) ;
          else
            cerr << "p7 not defined in hex geometry"<< endl ;
          vector3d<real_t> pts[8] ;
          pts[0] = p0 ;
          pts[1] = p1 ;
          pts[2] = p2 ;
          pts[3] = p3 ;
          pts[4] = p4 ;
          pts[5] = p5 ;
          pts[6] = p6 ;
          pts[7] = p7 ;
          geomList.push_back(new hexFunc(pts)) ;

        } else if (gname =="cylinder") {
          if(fol.optionExists("center")) {
            vector3d<real_t> center(0,0,0) ;
            fol.getOptionUnits("center","m",center) ;
            real_t radius= 0.0 ;
            fol.getOptionUnits("radius","m",radius) ;
            real_t thickness = 0.0;
            if (fol.optionExists("thickness")) // for hollow cylinders
              fol.getOption("thickness");
            geomList.push_back(new hollowGeneralCylinderFunc(center,radius,radius,thickness)) ;
          } else {
          if(fol.optionExists("p1")) {
              if(!fol.optionExists("p2") || fol.optionExists("center")) {
                cerr << "geometry definition cylinder should either include 'center' or 'p1' and 'p2' to define cylinder location and end caps." << endl ;
                Loci::Abort() ;
              }
              vector3d<real_t> p1(0,0,0) ;
              fol.getOptionUnits("p1","m",p1) ;
              vector3d<real_t> p2(0,0,0) ;
              fol.getOptionUnits("p2","m",p2) ;
              real_t radius = 0.0 ;
              fol.getOptionUnits("radius","m",radius) ;
              real_t thickness = 0.0;
              if (fol.optionExists("thickness")) // for hollow cylinders
                fol.getOption("thickness");
              geomList.push_back(new hollowGeneralCylinderFunc(p1,p2,radius,radius,radius,radius,thickness)) ;
            }
          }
        } else if(gname == "cone") {        
          if(fol.optionExists("center")) {
            vector3d<real_t> center(0,0,0) ;
            fol.getOptionUnits("center","m",center) ;
            real_t radius = 0.0 ;
            fol.getOptionUnits("radius","m",radius) ;
            real_t thickness = 0.0;
            if (fol.optionExists("thickness")) // for hollow cones
              fol.getOption("thickness",thickness);
            geomList.push_back(new hollowGeneralCylinderFunc(center,radius,0.0,thickness)) ;
          } else {
            if(fol.optionExists("p1")) {
              if(!fol.optionExists("p2") || fol.optionExists("center")) {
                cerr << "geometry definition cylinder should either include 'center' or 'p1' and 'p2' to define cylinder location and end caps." << endl ;
                Loci::Abort() ;
              }
              vector3d<real_t> p1(0,0,0) ;
              fol.getOptionUnits("p1","m",p1) ;
              vector3d<real_t> p2(0,0,0) ;
              fol.getOptionUnits("p2","m",p2) ;
              real_t radius = 0.0 ;
              fol.getOptionUnits("radius","m",radius) ;
              real_t thickness = 0.0;
              if (fol.optionExists("thickness")) // for hollow cones
                fol.getOption("thickness",thickness);
              geomList.push_back(new hollowGeneralCylinderFunc(p1,p2,radius, radius, radius, radius, thickness)) ;
            }
          }
        } else if(gname == "frustum") {        
          if(fol.optionExists("center")) {
            vector3d<real_t> center(0,0,0) ;
            fol.getOptionUnits("center","m",center) ;
            real_t radius = 0.0 ;
            fol.getOptionUnits("radius","m",radius) ;
            real_t thickness = 0;
            if (fol.optionExists("thickness")) // for hollow frustums
              fol.getOption("thickness",thickness);
            geomList.push_back(new hollowGeneralCylinderFunc(center,radius, 0.5*radius,thickness)) ;
          } else if(fol.optionExists("p1")) {
            if(!fol.optionExists("p2") || fol.optionExists("center")) {
              cerr << "geometry definition cylinder should either include 'center' or 'p1' and 'p2' to define cylinder location and end caps." << endl ;
              Loci::Abort() ;
            }
            vector3d<real_t> p1(0,0,0) ;
            fol.getOptionUnits("p1","m",p1) ;
            vector3d<real_t> p2(0,0,0) ;
            fol.getOptionUnits("p2","m",p2) ;
            real_t radius_base = 0.0 ;
            fol.getOptionUnits("radius_base","m",radius_base) ;
            real_t radius_top = 0. ;
            fol.getOptionUnits("radius_top","m",radius_top) ;
            real_t thickness = 0.0;
            if (fol.optionExists("thickness")) // for hollow frustums
              fol.getOption("thickness",thickness);
            geomList.push_back(new hollowGeneralCylinderFunc(p1,p2,radius_base, radius_top, radius_base, radius_top, thickness)) ;
          }
        } else if(gname == "sector") {        
            vector3d<real_t> p1(0,0,0) ;
            fol.getOptionUnits("p1","m",p1) ;
            vector3d<real_t> p2(0,0,0) ;
            fol.getOptionUnits("p2","m",p2) ;
            real_t angle = 360; // assume full revolution
            fol.getOption("angle",angle);
            angle *=M_PI/180; // converting to radians 
            real_t position;
            fol.getOption("position",position);
            vector3d<real_t> orientation(0,0,0) ;
            fol.getOptionUnits("orientation","",orientation) ;
            vector<vector3d<real_t>> vertices;
            if(ol.optionExists("points")) {
            Loci::option_value_type ovt= ol.getOptionValueType("points") ;
            if(ovt != Loci::LIST) {
              cerr << "list for geometry of component '" << tag
                  << "' must be a list" << endl ;
              Loci::Abort() ;
            }

            Loci::options_list::arg_list value_list ;
            ol.getOption("points",value_list) ;
            int sz = value_list.size() ;
            for(int i=0;i<sz;++i) {
              if(value_list[i].type_of() != FUNCTION) {
                cerr << "points should be a list of vertices in component '"
                    << tag << "'" << endl ;
              }
              string name ;
              value_list[i].get_value(name) ;
              if(name != "vertex") {
                cerr << "points for sector expecting a 'vertex'', not '"
                    << name << "'" << endl ;
                Loci::Abort() ;
              }
              options_list::arg_list fvalues ;
              value_list[i].get_value(fvalues) ;
              options_list fol ;
              fol.Input(fvalues) ;
              vector3d<real_t> pl;
            if(fol.optionExists("v")) {
                fol.getOptionUnits("v","meter",pl) ;
              } else {
                cerr << "vertex does not define point 'v=' in component '"
                    << tag << "'" << endl ;
                Loci::Abort() ;
              }
              vertices.push_back(pl) ;
            }
          }
          geomList.push_back(new sectorFunc(p1,p2,vertices,angle,position,orientation)) ;
        } else if(gname == "revolution") { // maintain backwards compatibility    
            // note: TBD to integrate/modify sector to support old style-offset    
            vector3d<real_t> p1(0,0,0) ;
            fol.getOptionUnits("p1","m",p1) ;
            vector3d<real_t> p2(0,0,0) ;
            fol.getOptionUnits("p2","m",p2) ;
            real_t angle = 360; // assume full revolution
            fol.getOption("angle",angle);
            angle *=M_PI/180; // converting to radians 
            real_t position;
            fol.getOption("position",position);
            vector3d<real_t> orientation(0,0,0) ;
            fol.getOptionUnits("orientation","",orientation) ;
            vector<vector3d<real_t>> vertices;
            if(ol.optionExists("points")) {
            Loci::option_value_type ovt= ol.getOptionValueType("points") ;
            if(ovt != Loci::LIST) {
              cerr << "list for geometry of component '" << tag
                  << "' must be a list" << endl ;
              Loci::Abort() ;
            }

            Loci::options_list::arg_list value_list ;
            ol.getOption("points",value_list) ;
            int sz = value_list.size() ;
            for(int i=0;i<sz;++i) {
              if(value_list[i].type_of() != FUNCTION) {
                cerr << "points should be a list of vertices in component '"
                    << tag << "'" << endl ;
              }
              string name ;
              value_list[i].get_value(name) ;
              if(name != "vertex") {
                cerr << "points for sector expecting a 'vertex'', not '"
                    << name << "'" << endl ;
                Loci::Abort() ;
              }
              options_list::arg_list fvalues ;
              value_list[i].get_value(fvalues) ;
              options_list fol ;
              fol.Input(fvalues) ;
              vector3d<real_t> pl;
              if(fol.optionExists("v")) {
                fol.getOptionUnits("v","meter",pl) ;
              } else {
                cerr << "vertex does not define point 'v=' in component '"
                    << tag << "'" << endl ;
                Loci::Abort() ;
              }
              vertices.push_back(pl) ;
            }
          }
          geomList.push_back(new sectorFunc(p1,p2,vertices,angle,position,orientation)) ;
        } else if(gname == "extrusion") {        
            vector3d<real_t> p1(0,0,0) ;
            fol.getOptionUnits("p1","m",p1) ;
            vector3d<real_t> p2(0,0,0) ;
            fol.getOptionUnits("p2","m",p2) ;
            real_t percentage;
            fol.getOption("percentage",percentage);
            vector<vector3d<real_t>> vertices;
            if(ol.optionExists("points")) {
            Loci::option_value_type ovt= ol.getOptionValueType("points") ;
            if(ovt != Loci::LIST) {
              cerr << "points for geometry of component '" << tag
                  << "' must be a list" << endl ;
              Loci::Abort() ;
            }

            Loci::options_list::arg_list value_list ;
            ol.getOption("points",value_list) ;
            int sz = value_list.size() ;
            for(int i=0;i<sz;++i) {
              if(value_list[i].type_of() != FUNCTION) {
                cerr << "points should be a list of vertices in component '"
                    << tag << "'" << endl ;
              }
              string name ;
              value_list[i].get_value(name) ;
              if(name != "vertex") {
                cerr << "points for sector expecting a 'vertex'', not '"
                    << name << "'" << endl ;
                Loci::Abort() ;
              }
              options_list::arg_list fvalues ;
              value_list[i].get_value(fvalues) ;
              options_list fol ;
              fol.Input(fvalues) ;
              vector3d<real_t> pl;
            if(fol.optionExists("v")) {
                fol.getOptionUnits("v","meter",pl) ;
              } else {
                cerr << "vertex does not define point 'v=' in component '"
                    << tag << "'" << endl ;
                Loci::Abort() ;
              }
              vertices.push_back(pl) ;
            }
            geomList.push_back(new extrusionFunc(p1,p2,vertices,percentage)) ;
          }
        } else if(gname ==  "sphere") {
          vector3d<real_t> center(0,0,0) ;
          fol.getOptionUnits("center","m",center) ;
          real_t radius = 0 ;
          fol.getOptionUnits("radius","m",radius) ;
          geomList.push_back(new sphereFunc(center,radius)) ;
        } else if(gname ==  "box") {
          vector3d<real_t> p1(0,0,0) ;
          vector3d<real_t> p2(0,0,0) ;
          fol.getOptionUnits("p1","m",p1) ;
          fol.getOptionUnits("p2","m",p2) ;
          geomList.push_back(new boxFunc(p1,p2)) ;
        } else if (gname == "planeList") {
          vector<vector3d<real_t> > points ;
          vector<vector3d<real_t> > normals ;

          if(ol.optionExists("list")) {
          Loci::option_value_type ovt= ol.getOptionValueType("list") ;
          if(ovt != Loci::LIST) {
            cerr << "list for geometry of component '" << tag
                << "' must be a list" << endl ;
            Loci::Abort() ;
          }

          Loci::options_list::arg_list value_list ;
          ol.getOption("list",value_list) ;
          int sz = value_list.size() ;
          for(int i=0;i<sz;++i) {
            if(value_list[i].type_of() != FUNCTION) {
              cerr << "list should be a list of plane functions in component '"
                  << tag << "'" << endl ;
            }
            string name ;
            value_list[i].get_value(name) ;
            if(name != "plane") {
              cerr << "planeList expecting a list of 'plane', not '"
                  << name << "'" << endl ;
              Loci::Abort() ;
            }
            options_list::arg_list fvalues ;
            value_list[i].get_value(fvalues) ;
            options_list fol ;
            fol.Input(fvalues) ;
            vector3d<real_t> pl,nl ;
            if(fol.optionExists("p")) {
              fol.getOptionUnits("p","meter",pl) ;
            } else {
              cerr << "plane does not define point 'p=' in component '"
                  << tag << "'" << endl ;
              Loci::Abort() ;
            }
            if(fol.optionExists("n")) {
              fol.getOptionUnits("n","meter",nl) ;
            } else {
              cerr << "plane does not define normal 'n=' in component '"
                  << tag << "'" << endl ;
              Loci::Abort() ;
            }
            points.push_back(pl) ;
            normals.push_back(nl) ;
          }
        }
          geomList.push_back(new planelistFunc(points,normals)) ;
        } else {
          cerr << "unknown geometry '" << gname << "' in Overset Geometry" << endl ;
          Loci::Abort() ;
        }
      }
      // Aggregate subgeometries into a composite geometry, if available
      if(geomList.size() == 0) {
        cerr << "Overset Geometry must have at least one geometry definition"
            << endl ;
        Loci::Abort() ;
      } else if(geomList.size() == 1) {
        Loci::CPTR<geometry_type> comp = geomList[0];
        (*$componentGeometryData)[tag] = comp ;
#ifdef OVERSET_DEBUG   
        const auto& mmp = *$componentGeometryData;
        for (const auto& [key, geom_ptr]: mmp) {
        std::cout << "geometry list is single entry " << endl;
        std::cout << "geometry tag is " << tag << " " << key << endl;
        }
#endif
      } else {
        Loci::CPTR<geometry_type> comp = new compositeFunc(geomList) ;
        (*$componentGeometryData)[tag] = comp; 
      }
    }
  } ;



  /// Unit/apply rule to fill the list of geometry_types for each component.
  /// Default is specified here in the unit rule where if there is no
  /// component motion, the geometry list is just copied from the geometry
  /// data. This variable is related to the componentGeometry in the sense that
  /// it is tracking the transformations applied to the analytic geometry
  /// types for use with hole cutting.
  $rule unit(componentGeometryList<-componentNameList,componentGeometryData),
  prelude {
    vector<Loci::CPTR<geometry_type> > tmp ;
    for(size_t i=0;i<(*$componentNameList).size();++i) {
      map<string,Loci::CPTR<geometry_type> >::const_iterator mi ;
      mi = (*$componentGeometryData).find((*$componentNameList)[i]) ;
      if(mi == (*$componentGeometryData).end()) {
        tmp.push_back(Loci::CPTR<geometry_type>(0)) ;
      } else {
        Loci::CPTR<geometry_type> gp = mi->second ;
        tmp.push_back(gp) ;
      }
    }
    (*$componentGeometryList) = tmp ;

    // Check to make sure that every geometry specified is in the componentNameList
    map<string,Loci::CPTR<geometry_type> >::const_iterator mi ;
    for(mi=(*$componentGeometryData).begin();
        mi!=(*$componentGeometryData).end(); ++mi) {
      const string geo_name = mi->first ;
      bool found = false ;
      for(size_t i=0;i<(*$componentNameList).size();++i) {
        if(geo_name == (*$componentNameList)[i]) {
          found = true ;
        }
      }

      if(!found) {
	      $[Once] {
          cerr << "componentGeometry id='" << geo_name
               << "' not found in vog file volume tags" << endl ;

          cerr << "volume tags = [" ;
          for(size_t i=0;i<(*$componentNameList).size();++i) {
            cerr << ' ' << (*$componentNameList)[i] ;
          }
          cerr << " ]" << endl
               << "check componentGeometry input in vars file!" << endl ;
        }
        Loci::Abort() ;
      }
    }
  } ;

  /// Dummy rule to avoid message
  $rule apply(componentGeometryList<-componentNameList,componentGeometry)
  [Loci::NullOp], prelude { } ;

  /// If there is motion, replace the component geometry provided by the stationary
  /// componentGeometryData with the transformed analytical component geometry. This
  /// is used for hole-cutting purposes.
  $rule apply(componentGeometryList<-componentNameList,componentGeometryData,
  componentTransformMap)[Loci::NullOp], prelude {
    vector<Loci::CPTR<geometry_type> > tmp ;

    // Loop over each component
    for(size_t i=0;i<(*$componentNameList).size();++i) {
      map<string,Loci::CPTR<geometry_type> >::const_iterator mi ;
      mi = (*$componentGeometryData).find((*$componentNameList)[i]) ;
      if(mi == (*$componentGeometryData).end()) {
        tmp.push_back(Loci::CPTR<geometry_type>(0)) ;
      } else {
        map<string,vector<componentXform> >::const_iterator mi2 ;
        mi2 = (*$componentTransformMap).find((*$componentNameList)[i]) ;
        Loci::CPTR<geometry_type> gp = mi->second ;
        if(mi2 != (*$componentTransformMap).end()) {
          int sz = mi2->second.size() ;
          for(int i=0;i<sz;++i) {
            Loci::CPTR<geometry_type> ngp = gp->applyXform(mi2->second[i]) ;
            gp = ngp ;
          }
        }
        tmp.push_back(gp) ;
      }
    }
    (*$componentGeometryList) = tmp ;
  } ;

}
