/// Number of refinement-tree edges between an active cell and its base cell.
$type refinementDepth store<int> ;

/// Base-VOG file number of the cell whose plan produced an active cell.
$type rootCellFileNumber store<int> ;

/// Latest online transition: derefined (-1), retained (0), or refined (1).
$type adaptResult store<int> ;
