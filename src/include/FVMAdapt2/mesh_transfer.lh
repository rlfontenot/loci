/// Persistent identity on mesh nodes, not a Loci entity or file number.
$type nodeId store<Loci::NodeId> ;

/// Valid source-to-target node relation from the latest supported AMR cycle.
$type nodeRemap blackbox<Loci::CPTR<Loci::NodeRemap> > ;

/// Construction result for the latest attempted node transition.
$type nodeTransitionReport blackbox<Loci::NodeTransitionReport> ;

/// Old-face overlaps and created/removed faces from the latest adaptation.
/// Source is the previous mesh; target is the resulting mesh. This blackbox
/// describes locally owned target faces, not a per-face store.
$type faceRemap blackbox<Loci::CPTR<Loci::FaceRemap> > ;

/// Construction result for the latest attempted face transition.
$type faceTransitionReport blackbox<Loci::FaceTransitionReport> ;

/// Persistent identity on mesh faces, not a Loci entity or file number.
$type faceId store<Loci::FaceId> ;

/// Persistent identity on geom_cells, not a Loci entity or file number.
$type cellId store<Loci::CellId> ;
